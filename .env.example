# ===== DeepSeek API（必填）=====
# 在 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== 微信推送（至少配一个；推荐 PushPlus）=====
# PushPlus：微信扫码登录 https://www.pushplus.plus/ ，在「一对一推送」里复制 token
PUSHPLUS_TOKEN=

# Server酱 Turbo：微信扫码 https://sct.ftqq.com/ ，复制 SendKey
SERVERCHAN_SENDKEY=

# WxPusher：https://wxpusher.zjiecode.com/ 创建应用，复制 appToken
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=

# 企业微信群机器人 webhook
WECOM_WEBHOOK=

# 显式指定渠道：pushplus / serverchan / wxpusher / wecom / email；留空自动选择
NOTIFY_PROVIDER=

# ===== 可选 =====
# 自定义 DeepSeek API base（例如走中转）
DEEPSEEK_BASE_URL=
# 时区
RADAR_TZ=Asia/Shanghai
